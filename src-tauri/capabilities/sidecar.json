{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "sidecar",
  "description": "Permiso para ejecutar el sidecar Python",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "juan-vivi-backend",
          "sidecar": true,
          "args": [{ "validator": "\\d+" }]
        }
      ]
    }
  ]
}
